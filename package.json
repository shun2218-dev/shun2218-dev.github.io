{
  "name": "shun2218-dev.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm fonts && next dev",
    "build": "pnpm fonts && next build",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
