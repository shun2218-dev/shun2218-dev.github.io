    "fonts": "node scripts/subset-fonts.mjs",
    "screenshots": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/optimize-screenshots.mjs",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@expo-google-fonts/noto-sans-jp": "0.4.3",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "sharp": "^0.35.5",
    "subset-font": "2.9.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
